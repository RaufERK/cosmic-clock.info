# Local (Next.js) — default port 3000 for `npm run dev`
NODE_ENV=development

# Local Postgres via: docker compose up -d
# (host port 5433 — see docs/INFRA.md)
DATABASE_URL=postgresql://cosmic_clock:cosmic_clock@127.0.0.1:5433/cosmic_clock

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string

# Comma-separated logins that can open /admin (compared case-insensitively)
# ADMIN_LOGINS=

# Production (server shared/.env) also sets:
# HOSTNAME=127.0.0.1
# PORT=3060
# DATABASE_URL=postgresql://…@127.0.0.1:5432/cosmic_clock
# AUTH_SECRET=…

# Umami (optional locally; set on production for analytics)
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=/ua.js

# Sentry (errors + tracing). Same DSN is fine for client + server.
# NEXT_PUBLIC_SENTRY_DSN=https://…@….ingest.sentry.io/…
# SENTRY_DSN=https://…@….ingest.sentry.io/…
# Optional (source maps on `next build`):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

