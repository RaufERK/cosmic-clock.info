// Cosmic Clock — Prisma schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  /// Last authenticated activity (register/login or throttled visit).
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cards        Card[]
}

/// Life-event card with date → cosmic clock hands.
/// Max 100 cards per user is enforced in application code.
/// Unique start date per user is Stage I.
model Card {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  day       Int
  month     Int
  year      Int
  /// User-facing list order (0 = first). New cards get max+1. Gaps after delete are OK.
  sortIndex Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year, month, day])
  @@index([userId])
  @@index([userId, sortIndex])
}
